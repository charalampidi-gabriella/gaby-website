---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latest = notes.slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// The headline wins: one number each, read in a glance.
const wins = [
  { stat: '86%', label: 'Disputes won', line: 'Learned what wins, then built an AI agent to do it.' },
  { stat: '2x', label: 'Racket sales', line: 'Led the reorganization of all three pro shops.' },
  { stat: '10+', label: 'Hires onboarded', line: 'Built onboarding from nothing, guides included.' },
];

// Everything else: the problem, then the fix, one short line each.
const fixes = [
  { name: 'Policy documentation', problem: "Rules lived in people's heads.", fix: "Now they're written down." },
  { name: 'Booking desk toolkit', problem: "Our booking software couldn't enforce our rules.", fix: 'Twenty-six tools now do.' },
  { name: 'Inventory system', problem: 'No reliable stock count across three clubs.', fix: 'Now every item is tracked.' },
  { name: 'Gift cards', problem: "Our booking system couldn't sell gifts.", fix: 'Now it can.' },
  { name: 'rippnertennis.com', problem: 'The site ran on WordPress.', fix: 'Rebuilt it from scratch.' },
];

const linkedin = 'https://www.linkedin.com/in/gabycharalampidi/';

// The four facts under the headline: scannable in a few seconds on a phone.
const proof = [
  { stat: '14 months', detail: 'Branch manager to COO' },
  { stat: '50 staff', detail: 'Three clubs, 363 days a year' },
  { stat: 'World #245', detail: 'ITF juniors, Greek National Team' },
  { stat: 'B.S. CS&E', detail: 'D1 tennis at Nevada' },
];

// Paste each Credly verification link into `url`; one without a link renders as plain text.
const credentials = [
  {
    abbr: 'CAPM',
    name: 'Certified Associate in Project Management',
    issuer: 'PMI',
    url: 'https://www.credly.com/badges/e34df230-9dd3-48f4-9af7-d648428b7f52/public_url',
  },
  {
    abbr: 'PSM I',
    name: 'Professional Scrum Master I',
    issuer: 'Scrum.org',
    url: 'https://www.credly.com/badges/e156c4a2-b5a7-486f-b676-78a1d701f818/public_url',
  },
];
---

<Layout title="Gaby Charalampidi" current="home">
  <section class="hero">
    <!-- To scale: 78x36 ft doubles court at 3.2 px/ft, net posts 3 ft outside the sidelines -->
    <svg class="court" viewBox="0 0 160 270" aria-hidden="true" fill="none">
      <rect x="22.4" y="10" width="115.2" height="249.6" stroke="currentColor" />
      <line x1="36.8" y1="10" x2="36.8" y2="259.6" stroke="currentColor" />
      <line x1="123.2" y1="10" x2="123.2" y2="259.6" stroke="currentColor" />
      <line x1="36.8" y1="67.6" x2="123.2" y2="67.6" stroke="currentColor" />
      <line x1="36.8" y1="202" x2="123.2" y2="202" stroke="currentColor" />
      <line x1="80" y1="67.6" x2="80" y2="202" stroke="currentColor" />
      <line x1="80" y1="10" x2="80" y2="16" stroke="currentColor" />
      <line x1="80" y1="259.6" x2="80" y2="253.6" stroke="currentColor" />
      <line x1="12.8" y1="134.8" x2="147.2" y2="134.8" stroke="currentColor" stroke-width="2" />
    </svg>
    <p class="eyebrow">Austin, TX</p>
    <h1>
      I <em>run</em> the operation, <em>lead</em> the team, and let <em>AI</em> handle what doesn't need a human.
    </h1>
    <p class="lede">
      COO at <a href="https://rippnertennis.com">Rippner Tennis</a>, a three-location tennis
      operation in Austin. Former national team player and an engineer by&nbsp;training.
    </p>
    <dl class="proof">
      {
        proof.map((p) => (
          <div>
            <dt>{p.stat}</dt>
            <dd>{p.detail}</dd>
          </div>
        ))
      }
    </dl>
    <p class="hero-actions">
      <a class="btn" href={linkedin}>Connect on LinkedIn</a>
      <a class="hero-alt" href="#contact">or send a note</a>
    </p>
  </section>

  <section class="section" id="work">
    <h2 class="label">Problems I've solved</h2>
    <p class="kicker">
      Everything here started as something that broke, cost money, or lived in one person's head.
    </p>
    <dl class="wins">
      {
        wins.map((w) => (
          <div>
            <dt>{w.stat}</dt>
            <dd class="win-label">{w.label}</dd>
            <dd class="win-line">{w.line}</dd>
          </div>
        ))
      }
    </dl>
    <ul class="fixes">
      {
        fixes.map((f) => (
          <li>
            <h3>{f.name}</h3>
            <p>
              <span class="problem">{f.problem}</span> {f.fix}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" id="path">
    <h2 class="label">The path</h2>
    <ol class="timeline">
      <li>
        <p class="tl-era">Greece</p>
        <h3>Competitive tennis</h3>
        <p>ITF juniors, a world ranking of 245, and the Greek National Team.</p>
      </li>
      <li>
        <p class="tl-era">Reno, NV</p>
        <h3>Engineering</h3>
        <p>
          Division I tennis at Nevada on a full athletic scholarship, with a B.S. in Computer
          Science and Engineering earned along the way.
        </p>
      </li>
      <li>
        <p class="tl-era">Austin, TX</p>
        <h3>Rippner Tennis</h3>
        <p>
          Branch manager to operations manager to COO in fourteen months. Three facilities, 50
          staff, 363 days a year.
        </p>
      </li>
      <li class="future">
        <p class="tl-era">Next</p>
        <h3>What's coming</h3>
        <p>
          <a href="https://playkorta.com">Korta</a>, a tennis matchmaking platform I'm a
          founding member of, launches in Austin. At Rippner, more of the operation gets
          automated, and I write about that work here.
        </p>
      </li>
    </ol>
    <p class="creds">
      <span class="creds-label">Credentials</span>
      {
        credentials.map((c, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> &middot; </span>}
            {c.url ? (
              <a href={c.url} title={c.name}>{c.abbr} ({c.issuer})</a>
            ) : (
              <span title={c.name}>{c.abbr} ({c.issuer})</span>
            )}
          </>
        ))
      }
    </p>
  </section>

  {
    latest.length > 0 && (
      <section class="section" id="notes">
        <h2 class="label">Latest notes</h2>
        <ul class="note-list">
          {latest.map((note) => (
            <li>
              <a href={`/notes/${note.id}`}>{note.data.title}</a>
              <span class="note-meta">
                {note.data.topic && <span class="topic-chip">{note.data.topic}</span>}
                {note.data.type === 'video' && <span class="tag">Video</span>}
                <time datetime={note.data.date.toISOString()}>{fmt(note.data.date)}</time>
              </span>
            </li>
          ))}
        </ul>
        <p class="all-notes">
          <a href="/notes">All notes &rarr;</a>
        </p>
      </section>
    )
  }

  <section class="section" id="contact">
    <h2 class="label">Contact</h2>
    <p class="contact-line">Happy to connect.</p>
    <p class="muted contact-copy">
      I like meeting people working in sports, AI, or automation, and anyone curious about what
      I'm building. Find me on
      <a href={linkedin}>LinkedIn</a> or
      send a note here:
    </p>
    <form id="contact-form">
      <input type="hidden" name="access_key" value="b16c0877-faf2-4a0b-83b6-aaee2e00087a" />
      <input
        type="checkbox"
        name="botcheck"
        class="botcheck"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />
      <div class="form-row">
        <label>
          Name
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label>
          Email
          <input type="email" name="email" required autocomplete="email" />
        </label>
      </div>
      <label>
        Message
        <textarea name="message" rows="5" required></textarea>
      </label>
      <button type="submit">Send</button>
      <p class="form-status" role="status"></p>
    </form>
  </section>
</Layout>

<script>
  // Scroll effects, all skipped for reduced-motion users:
  // - the hero court sketch lags the page slightly
  // - the timeline baseline draws itself in as you scroll through it
  const court = document.querySelector<SVGElement>('.court');
  const timeline = document.querySelector<HTMLElement>('.timeline');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion && (court || timeline)) {
    const update = () => {
      if (court) court.style.transform = `translateY(${window.scrollY * 0.12}px)`;
      if (timeline) {
        const rect = timeline.getBoundingClientRect();
        const focal = window.innerHeight * 0.7;
        const drawn = Math.min(Math.max(focal - rect.top, 0), rect.height);
        timeline.style.setProperty('--tl-progress', `${drawn}px`);
      }
      ticking = false;
    };
    let ticking = false;
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );
    update();
  }

  // Timeline entries fade up as they enter the viewport.
  if (timeline && !reduceMotion) {
    const items = [...timeline.querySelectorAll('li')];
    items.forEach((li) => li.classList.add('tl-hidden'));
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove('tl-hidden');
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -12% 0px' }
    );
    items.forEach((li) => io.observe(li));
  }

  // Contact form: submits through Web3Forms. Until an access key is set,
  // falls back to opening a prefilled email so the form always works.
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) {
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const button = form.querySelector<HTMLButtonElement>('button')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (data.botcheck) return;
      if (!data.access_key || data.access_key === 'WEB3FORMS_ACCESS_KEY') {
        status.textContent = 'The form is not connected yet. Message me on LinkedIn instead.';
        return;
      }
      button.disabled = true;
      status.textContent = 'Sending...';
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (!json.success) throw new Error(json.message);
        form.reset();
        status.textContent = 'Got it. I read everything that comes in here.';
      } catch {
        status.textContent = 'That did not go through. Reach me on LinkedIn instead.';
      }
      button.disabled = false;
    });
  }
</script>

<style>
  .hero {
    position: relative;
    margin-top: 3.5rem;
  }

  .court {
    position: absolute;
    top: -1.5rem;
    right: -2.5rem;
    width: 175px;
    color: var(--line);
    z-index: -1;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 6.5vw, 3.4rem);
    max-width: 20ch;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--accent);
  }

  .lede {
    margin-top: 1.3rem;
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 32rem;
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
    margin: 2rem 0 0;
    padding: 1.2rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .proof dt {
    font-family: var(--serif);
    font-size: 1.4rem;
    line-height: 1.15;
    color: var(--accent);
  }

  .proof dd {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem 1.1rem;
    margin: 1.6rem 0 0;
  }

  .btn {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    background: var(--accent);
    color: var(--bg);
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 120ms ease;
  }

  .btn:hover {
    color: var(--bg);
    opacity: 0.85;
  }

  .hero-alt {
    font-size: 0.92rem;
    color: var(--muted);
  }

  .kicker {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--ink);
    max-width: 30rem;
    margin: 0 0 2rem;
  }


  .wins {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
    margin: 0 0 3.2rem;
  }

  .wins dt {
    font-family: var(--serif);
    font-size: 3rem;
    line-height: 1;
    color: var(--accent);
  }

  .win-label {
    margin: 0.7rem 0 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .win-line {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .fixes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.15rem;
  }

  .fixes li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1.2rem;
    align-items: baseline;
  }

  .fixes h3 {
    font-size: 1.05rem;
  }

  .fixes p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink);
  }

  .fixes .problem {
    color: var(--faint);
  }

  .timeline {
    list-style: none;
    padding: 0 0 0 1.8rem;
    margin: 0;
    position: relative;
  }

  /* the vertical baseline */
  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 1px;
    background: var(--line);
  }

  /* the drawn-in portion of the baseline, height driven by scroll */
  .timeline::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0.4rem;
    width: 1px;
    height: var(--tl-progress, 0px);
    max-height: calc(100% - 0.8rem);
    background: var(--accent);
  }

  .timeline li {
    position: relative;
    padding-bottom: 2.2rem;
    transition: opacity 600ms ease, transform 600ms ease;
  }

  .timeline li.tl-hidden {
    opacity: 0;
    transform: translateY(14px);
  }

  .timeline li:last-child {
    padding-bottom: 0;
  }

  /* tick node crossing the baseline, same mark as the section dividers */
  .timeline li::before {
    content: '';
    position: absolute;
    left: -1.8rem;
    top: 0.5rem;
    width: 11px;
    height: 1px;
    background: var(--ink);
    transform: translateX(-5px);
  }

  .tl-era {
    margin: 0 0 0.3rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .timeline h3 {
    font-size: 1.25rem;
    margin: 0 0 0.4rem;
  }

  .timeline p:not(.tl-era) {
    margin: 0;
    color: var(--muted);
    max-width: 32rem;
  }

  .timeline li.future::before {
    background: var(--faint);
  }

  .timeline li.future h3,
  .timeline li.future p:not(.tl-era) {
    opacity: 0.75;
  }

  .creds {
    margin: 2.4rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .creds-label {
    margin-right: 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .note-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.7rem;
  }

  .note-list li {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1.1rem;
    background: #1c1f26;
    border: 1px solid var(--line);
    border-radius: 10px;
    transition: border-color 140ms ease;
  }

  .note-list li:hover {
    border-color: rgba(167, 182, 201, 0.45);
  }

  .note-list a {
    text-decoration: none;
    font-weight: 500;
  }

  /* Stretch the title link to cover the whole card so the full box is clickable */
  .note-list a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 10px;
  }

  .note-meta {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-size: 0.85rem;
    color: var(--faint);
    white-space: nowrap;
  }

  .tag {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
  }

  .all-notes {
    margin-top: 1rem;
    font-size: 0.92rem;
  }

  .contact-line {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin: 0 0 0.8rem;
  }

  .contact-copy {
    max-width: 34rem;
  }

  #contact-form {
    margin-top: 1.8rem;
    max-width: 34rem;
  }

  .botcheck {
    display: none;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  #contact-form label {
    display: block;
    margin-bottom: 1rem;
    font-size: 0.78rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }

  #contact-form input[type='text'],
  #contact-form input[type='email'],
  #contact-form textarea {
    display: block;
    width: 100%;
    margin-top: 0.4rem;
    padding: 0.65rem 0.8rem;
    background: #21242c;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.98rem;
    letter-spacing: normal;
    text-transform: none;
    box-sizing: border-box;
    resize: vertical;
  }

  #contact-form input:focus,
  #contact-form textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  #contact-form button {
    margin-top: 0.2rem;
    padding: 0.65rem 1.6rem;
    background: var(--accent);
    color: var(--bg);
    border: 0;
    border-radius: 8px;
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 120ms ease;
  }

  #contact-form button:hover {
    opacity: 0.85;
  }

  #contact-form button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .form-status {
    margin: 0.9rem 0 0;
    font-size: 0.92rem;
    color: var(--muted);
    min-height: 1.4em;
  }

  @media (max-width: 560px) {
    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  @media (max-width: 560px) {
    .court {
      display: none;
    }

    .hero {
      margin-top: 2.2rem;
    }

    .hero h1 {
      font-size: 1.85rem;
    }

    .lede {
      margin-top: 1rem;
      font-size: 1rem;
    }

    .proof {
      grid-template-columns: 1fr 1fr;
      gap: 1rem 1.2rem;
      margin-top: 1.5rem;
    }

    .proof dt {
      font-size: 1.25rem;
    }

    .wins {
      grid-template-columns: 1fr;
      gap: 1.3rem;
      margin-bottom: 2.6rem;
    }

    .wins > div {
      display: grid;
      grid-template-columns: 4.6rem 1fr;
      column-gap: 1rem;
    }

    .wins dt {
      grid-row: span 2;
      font-size: 2.4rem;
    }

    .win-label {
      margin-top: 0.15rem;
    }

    .fixes {
      gap: 1.3rem;
    }

    .fixes li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
